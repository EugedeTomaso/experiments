# === Hetzner ===
HCLOUD_TOKEN=your-hetzner-api-token

# === Database ===
DB_NAME=mive
DB_USER=mive
DB_PASSWORD=          # Generated by provision.py
DB_HOST=db
DB_PORT=5432

# === Django ===
DJANGO_SECRET_KEY=    # Generated by provision.py
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS= # Server IP
ENCRYPTION_KEY=        # Generated by provision.py (Fernet key)
CSRF_TRUSTED_ORIGINS=  # http://<server-ip>
INTERNAL_API_KEY=      # Generated by provision.py

# === JWT (must match DJANGO_SECRET_KEY) ===
JWT_SECRET=

# === Frontend (baked into JS at build time) ===
VITE_API_BASE=         # http://<server-ip>
VITE_COLLAB_URL=       # ws://<server-ip>/ws
